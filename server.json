{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.fulcradynamics/context",
  "title": "Fulcra",
  "description": "Use your Fulcra secure context lake to collaborate with other agents, read and write data, and more",
  "version": "1.1.0",
  "websiteUrl": "https://fulcradynamics.com",
  "repository": {
    "url": "https://github.com/fulcradynamics/fulcra-context-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://mcp.fulcradynamics.com/icon.png",
      "mimeType": "image/png",
      "sizes": [
        "256x256"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.fulcradynamics.com/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "fulcra-context-mcp",
      "version": "1.1.0",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
